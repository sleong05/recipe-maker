<!doctype html>
<html>
<head>
<meta charset="utf-8">
<style>
  @font-face { font-family: "Inter"; font-weight: 400; src: url("fonts/inter-latin-400-normal.woff"); }
  @font-face { font-family: "Inter"; font-weight: 600; src: url("fonts/inter-latin-600-normal.woff"); }
  @font-face { font-family: "Inter"; font-weight: 700; src: url("fonts/inter-latin-700-normal.woff"); }
  @font-face { font-family: "Fraunces"; font-weight: 600; src: url("fonts/fraunces-latin-600-normal.woff"); }
  @font-face { font-family: "Fraunces"; font-style: italic; src: url("fonts/fraunces-latin-400-italic.woff"); }

  /* Black ink only: hierarchy comes from weight, size, italics and rules. */
  @page {
    size: letter;
    margin: 0.5in 0.55in 0.55in;
    @bottom-left {
      content: "{{ source }}";
      font: 7pt "Inter", "DejaVu Sans", sans-serif;
      color: #000;
    }
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: "Inter", "DejaVu Sans", sans-serif;
    font-size: {{ font_size }}pt;
    line-height: 1.38;
    color: #000;
    background: #fff;
  }

  /* 1. Header */
  header { border-bottom: 2px solid #000; padding-bottom: 0.6em; margin-bottom: 1em; }
  h1 { font-family: "Fraunces", "DejaVu Serif", serif; font-weight: 600; font-size: 2.3em; line-height: 1.1; }
  .summary { font-family: "Fraunces", "DejaVu Serif", serif; font-style: italic; font-size: 1.1em; margin-top: 0.2em; }
  .meta { display: flex; gap: 2em; margin-top: 0.55em; }
  .meta span { font-size: 0.72em; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; margin-right: 0.5em; }

  /* Section labels */
  h2 {
    font-size: 0.8em; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase;
    border-bottom: 1px solid #000; padding-bottom: 0.2em; margin-bottom: 0.5em;
  }
  h3 {
    font-family: "Fraunces", "DejaVu Serif", serif; font-style: italic; font-weight: 400;
    font-size: 1.05em; margin: 0 0 0.2em; break-after: avoid;
  }
  ul, ol { list-style: none; }

  /* 2. Ingredients: full width, flowed into two columns */
  .ingredients { margin-bottom: 1em; }
  .ingredient-list { column-count: 2; column-gap: 0.35in; }
  .group { break-inside: avoid; margin-bottom: 0.5em; }
  .ingredient-list li { padding: 0.15em 0; break-inside: avoid; }
  .qty { font-weight: 700; }
  .note { font-style: italic; }

  .equipment { margin-top: 0.3em; }
  .equipment span { font-weight: 700; }

  /* 3. Steps: full width, numbered */
  .steps h3 { margin-top: 0.6em; }
  .steps h3:first-of-type { margin-top: 0; }
  .step { display: flex; gap: 0.7em; padding: 0.3em 0; break-inside: avoid; }
  .num { flex-shrink: 0; width: 1.6em; font-weight: 700; text-align: right; }

  /* 4. Tips */
  .tips { margin-top: 1em; break-inside: avoid; }
  .tips li { padding-left: 1em; position: relative; margin-top: 0.2em; }
  .tips li::before { content: "–"; position: absolute; left: 0; }
</style>
</head>
<body>
  <header>
    <h1>{{ recipe.title }}</h1>
    {% if recipe.summary %}<p class="summary">{{ recipe.summary }}</p>{% endif %}
    {% set meta = [("Serves", recipe.servings), ("Prep", recipe.prep_time), ("Cook", recipe.cook_time)] | selectattr(1) | list %}
    {% if meta %}
    <div class="meta">
      {% for label, value in meta %}<div><span>{{ label }}</span>{{ value }}</div>{% endfor %}
    </div>
    {% endif %}
  </header>

  <section class="ingredients">
    <h2>Ingredients</h2>
    <div class="ingredient-list">
    {% for group in recipe.ingredient_groups %}
      <div class="group">
        {% if group.name and recipe.ingredient_groups | length > 1 %}<h3>{{ group.name }}</h3>{% endif %}
        <ul>
        {% for item in group.items %}
          <li>{% if item.quantity %}<span class="qty">{{ item.quantity | fractions }}{% if item.unit %} {{ item.unit }}{% endif %}</span> {% endif %}{{ item.name }}{% if item.note %}<span class="note">, {{ item.note | fractions }}</span>{% endif %}</li>
        {% endfor %}
        </ul>
      </div>
    {% endfor %}
    </div>
    {% if recipe.equipment %}
    <p class="equipment"><span>You'll need:</span> {{ recipe.equipment | map("sentence") | join(", ") | fractions }}</p>
    {% endif %}
  </section>

  <section class="steps">
    <h2>Instructions</h2>
    {% set counter = namespace(n=0) %}
    {% for group in recipe.step_groups %}
      {% if group.name and recipe.step_groups | length > 1 %}<h3>{{ group.name }}</h3>{% endif %}
      {% for step in group.steps %}
        {% set counter.n = counter.n + 1 %}
        <div class="step"><div class="num">{{ counter.n }}.</div><div>{{ step | fractions }}</div></div>
      {% endfor %}
    {% endfor %}
  </section>

  {% if recipe.tips %}
  <section class="tips">
    <h2>Tips</h2>
    <ul>{% for tip in recipe.tips %}<li>{{ tip | fractions }}</li>{% endfor %}</ul>
  </section>
  {% endif %}
</body>
</html>
