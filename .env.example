# LLM providers, tried in this order on every call. If one fails (rate limit, out of
# credits, server down) the next one is tried. Free tiers first, paid last.
# Options: gemini, groq, cerebras, openrouter, ollama, local, gemini_paid
LLM_PROVIDERS=gemini,groq,cerebras,openrouter,gemini_paid

# Each provider takes one key or several comma-separated keys; each key is tried in turn.
# Providers with no key are skipped. Override a model with <NAME>_MODEL=...

# Gemini free tier (https://aistudio.google.com/apikey)
GEMINI_API_KEYS=
# GEMINI_MODEL=gemini-3.6-flash

# Groq (https://console.groq.com/keys)
GROQ_API_KEYS=
# GROQ_MODEL=openai/gpt-oss-120b

# Cerebras (https://cloud.cerebras.ai)
CEREBRAS_API_KEYS=
# CEREBRAS_MODEL=gpt-oss-120b

# OpenRouter free models (https://openrouter.ai/keys)
OPENROUTER_API_KEYS=
# OPENROUTER_MODEL=openai/gpt-oss-120b:free

# Ollama Cloud (no longer free as of late Oct 2026)
OLLAMA_API_KEYS=
# OLLAMA_MODEL=gpt-oss:120b

# Paid Gemini key (class key): last resort when the free tiers run out
GEMINI_PAID_API_KEYS=
# GEMINI_PAID_MODEL=gemini-3.6-flash

# Local model via `ollama serve` (add "local" to LLM_PROVIDERS to use it; no key needed)
# LOCAL_OLLAMA_URL=http://localhost:11434/v1
# LOCAL_OLLAMA_MODEL=gpt-oss:20b

# LLM_TEMPERATURE=0
